# Hashed build files never change, so browsers keep them for a year without
# asking again. Hosts that don't read _headers ignore this file.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Nimbus agent discovery (generated)
/mac-mlx-study
  Link: <https://bear2u.github.io/.well-known/ard.json>; rel="ard"
  Link: <https://bear2u.github.io/mac-mlx-study/llms.txt>; rel="describedby"; type="text/plain"
  Link: <https://bear2u.github.io/mac-mlx-study/index.md>; rel="alternate"; type="text/markdown"

/mac-mlx-study/
  Link: <https://bear2u.github.io/.well-known/ard.json>; rel="ard"
  Link: <https://bear2u.github.io/mac-mlx-study/llms.txt>; rel="describedby"; type="text/plain"
  Link: <https://bear2u.github.io/mac-mlx-study/index.md>; rel="alternate"; type="text/markdown"

/.well-known/ard.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *

/.well-known/ai-catalog.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *

/mac-mlx-study/index.md
  Content-Type: text/markdown; charset=utf-8

/mac-mlx-study/llms.txt
  Content-Type: text/plain; charset=utf-8

/mac-mlx-study/llms-full.txt
  Content-Type: text/plain; charset=utf-8

/mac-mlx-study/robots.txt
  Content-Type: text/plain; charset=utf-8

/mac-mlx-study/*/llms.txt
  Content-Type: text/plain; charset=utf-8

/mac-mlx-study/*/index.md
  Content-Type: text/markdown; charset=utf-8
# End Nimbus agent discovery
